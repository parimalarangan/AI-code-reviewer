# Copy this file to `.env` in the backend/ directory and adjust as needed.
# None of these values are secret by default because the default provider
# (Ollama) needs no API key at all.

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Choose your free LLM provider ----
# ollama (recommended, fully local & free) | groq | huggingface | openai_compatible
LLM_PROVIDER=ollama

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# --- Groq (free tier, cloud) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Hugging Face free Inference API ---
# Get a free token at https://huggingface.co/settings/tokens
HF_API_KEY=
HF_MODEL=bigcode/starcoder2-15b

# --- Generic OpenAI-compatible endpoint (optional, advanced) ---
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

MAX_CODE_LENGTH_CHARS=20000
LLM_REQUEST_TIMEOUT_SECONDS=60
